{
  "name": "@grimkeeper/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm db:generate:if-needed && tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:generate:if-needed": "node scripts/generate-if-stale.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:push": "prisma db push && node scripts/generate-if-stale.mjs",
    "db:migrate-votes": "node scripts/migrate-votes.mjs",
    "db:backfill-winners": "node scripts/backfill-winners.mjs"
  },
  "dependencies": {
    "@grimkeeper/engine": "workspace:*",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
