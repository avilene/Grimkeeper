generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Game {
  id                   String         @id @default(cuid())
  guildId              String
  channelId            String
  phase                String         @default("lobby")
  dayNumber            Int            @default(0)
  nightNumber          Int            @default(0)
  /** Final winning team when phase is ended: good | evil. */
  winner               String?
  /**
   * Origin of the game row. Null for live Discord games.
   * "stats_only" = admin-recorded completed game (no Discord posts/threads/roles).
   */
  source               String?
  /** Wall-clock start (live games may leave null; recorded games set this). */
  startedAt            DateTime?
  /** Wall-clock end (live games may leave null; recorded games set this). */
  endedAt              DateTime?
  /** When set, bot should push nomination/vote projection state to Discord and clear. */
  discordNomsRefreshRequestedAt DateTime?
  /** When set, bot should delete+repost open nomination embeds in kib and clear. */
  discordKibNomsRepostRequestedAt DateTime?
  /** When set with discordPingMissingNominationId, bot pings missing voters for that nom. */
  discordPingMissingRequestedAt DateTime?
  discordPingMissingNominationId String?
  /** null | "town" | "buffet" */
  setupMode            String?
  /** JSON: BuffetDraftConfig */
  buffetConfig         Json?
  stRoleId             String?
  playerRoleId         String?
  kibRoleId            String?
  kibThreadId          String?
  logThreadId          String?
  votingThreadId       String?
  whisperDeclThreadId  String?
  claimsThreadId       String?
  rulesThreadId        String?
  createdAt            DateTime       @default(now())
  events             GameEvent[]
  players            Player[]
  gameDays           GameDay[]
  reminders          GameReminder[]
  whispers           GameWhisper[]

  @@index([guildId])
  @@index([guildId, phase])
}

/** Private player whisper thread for a town game (pair or group). */
model GameWhisper {
  id                   String   @id @default(cuid())
  gameId               String
  threadId             String   @unique
  name                 String
  neighbor             Boolean  @default(false)
  creatorDiscordId     String
  /** Other player for pair whispers; empty for groups with 3+ members. */
  targetDiscordId      String   @default("")
  /** Sorted discord user ids joined by `,` for exact participant-set lookup. */
  participantKey       String   @default("")
  createdAt            DateTime @default(now())
  game                 Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([gameId, participantKey])
}

model Player {
  id            String  @id @default(cuid())
  gameId        String
  discordUserId String
  displayName   String
  seat          Int?
  /** Character id on the script (e.g. washerwoman, imp). */
  roleId        String?
  /** Final alignment for stats: good | evil | traveler. Stored separately because BotC alignment can diverge from character. */
  team          String?
  alive         Boolean @default(true)
  ghostVoteUsed Boolean @default(false)
  /** Private player ST Discord thread id. */
  stThreadId    String?
  game          Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, discordUserId])
  @@index([gameId])
}

model GameDay {
  id                  String       @id @default(cuid())
  gameId              String
  dayNumber           Int
  discordThreadId     String?
  nominationsOpen     Boolean      @default(true)
  voteVisibility      String       @default("public")
  executionUsed       Boolean      @default(false)
  nominationsPausedUntil DateTime?
  game                Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  nominations         Nomination[]
  votes               Vote[]

  @@unique([gameId, dayNumber])
  @@index([gameId])
}

model Nomination {
  id             String    @id
  gameDayId      String
  nominatorId    String
  nomineeId      String
  accusation     String
  defense        String?
  order          Int
  status         String
  /** When public voting closes (engine 24h deadline; editable in admin). */
  voteDeadlineAt DateTime?
  gameDay        GameDay   @relation(fields: [gameDayId], references: [id], onDelete: Cascade)
  votes          Vote[]

  @@index([gameDayId])
  @@index([gameDayId, order])
}

model Vote {
  id            String     @id @default(cuid())
  gameDayId     String
  nominationId  String
  voterId       String
  /** Public Town Voting ballot (yes / no / conditional). */
  choice        String?
  reason        String?
  /** Private ST-thread ballot (yes / no / conditional). */
  privateChoice String?
  privateReason String?
  nomination    Nomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)
  gameDay       GameDay    @relation(fields: [gameDayId], references: [id], onDelete: Cascade)

  @@unique([nominationId, voterId])
  @@index([gameDayId])
}

model GameReminder {
  id          String   @id @default(cuid())
  gameId      String?
  guildId     String
  channelId   String
  message     String
  emoji       String?
  sourceKey   String?  @unique
  fireAt      DateTime
  seriesEndAt DateTime?
  fired       Boolean  @default(false)
  pingPlayers Boolean  @default(false)
  pingRoleId  String?
  createdBy   String
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([fired, fireAt])
  @@index([gameId])
  @@index([guildId, channelId])
}

/** Guild-scoped display alias for a Discord user (shared across games). */
model PlayerAlias {
  guildId       String
  discordUserId String
  alias         String
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@id([guildId, discordUserId])
  @@index([guildId])
}

model GameEvent {
  id        String   @id @default(cuid())
  gameId    String
  type      String
  payload   Json
  seq       Int
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, seq])
  @@index([gameId])
  @@index([type, createdAt])
  @@index([createdAt])
}

/** Per-guild ST queue board (usually a dedicated Discord thread). */
model StQueueBoard {
  id             String         @id @default(cuid())
  guildId        String         @unique
  threadId       String
  panelMessageId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  entries        StQueueEntry[]

  @@index([threadId])
}

/** One storyteller's open (or closed) queue slot. */
model StQueueEntry {
  id             String           @id @default(cuid())
  boardId        String
  guildId        String
  ownerDiscordId String
  scriptName     String
  scriptLink     String           @default("")
  description    String           @default("")
  /** JSON string array of image URLs. */
  scriptImageUrls String          @default("[]")
  /** open | closed */
  status         String           @default("open")
  position       Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  board          StQueueBoard     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  members        StQueueMember[]

  @@index([guildId, status])
  @@index([boardId, position])
  @@index([ownerDiscordId])
}

/** Co-storyteller or interested player on a queue entry. */
model StQueueMember {
  id            String       @id @default(cuid())
  entryId       String
  discordUserId String
  /** co_st | player */
  role          String
  createdAt     DateTime     @default(now())
  entry         StQueueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, discordUserId, role])
  @@index([entryId])
  @@index([discordUserId])
}

/** Per-guild Discord configuration (archive category, etc.). */
model GuildSettings {
  guildId           String   @id
  /** Discord category ID for archived game town channels. */
  archiveCategoryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
