generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Game {
  id            String         @id @default(cuid())
  guildId       String
  channelId     String
  phase         String         @default("lobby")
  dayNumber     Int            @default(0)
  nightNumber   Int            @default(0)
  stRoleId      String?
  playerRoleId  String?
  kibRoleId     String?
  kibThreadId   String?
  logThreadId   String?
  createdAt     DateTime       @default(now())
  events      GameEvent[]
  players     Player[]
  gameDays    GameDay[]
  reminders   GameReminder[]

  @@index([guildId])
}

model Player {
  id            String  @id @default(cuid())
  gameId        String
  discordUserId String
  displayName   String
  seat          Int?
  roleId        String?
  alive         Boolean @default(true)
  ghostVoteUsed Boolean @default(false)
  game          Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, discordUserId])
  @@index([gameId])
}

model GameDay {
  id                  String       @id @default(cuid())
  gameId              String
  dayNumber           Int
  discordThreadId     String?
  nominationsOpen     Boolean      @default(true)
  voteVisibility      String       @default("public")
  executionUsed       Boolean      @default(false)
  nominationsPausedUntil DateTime?
  game                Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  nominations         Nomination[]
  votes               Vote[]

  @@unique([gameId, dayNumber])
  @@index([gameId])
}

model Nomination {
  id          String   @id
  gameDayId   String
  nominatorId String
  nomineeId   String
  accusation  String
  defense     String?
  order       Int
  status      String
  gameDay     GameDay  @relation(fields: [gameDayId], references: [id], onDelete: Cascade)
  votes       Vote[]

  @@index([gameDayId])
  @@index([gameDayId, order])
}

model Vote {
  id           String     @id @default(cuid())
  gameDayId    String
  nominationId String
  voterId      String
  choice       String
  reason       String?
  nomination   Nomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)
  gameDay      GameDay    @relation(fields: [gameDayId], references: [id], onDelete: Cascade)

  @@unique([nominationId, voterId])
  @@index([gameDayId])
}

model GameReminder {
  id          String   @id @default(cuid())
  gameId      String?
  guildId     String
  channelId   String
  message     String
  emoji       String?
  sourceKey   String?  @unique
  fireAt      DateTime
  seriesEndAt DateTime?
  fired       Boolean  @default(false)
  pingPlayers Boolean  @default(false)
  pingRoleId  String?
  createdBy   String
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([fired, fireAt])
  @@index([gameId])
  @@index([guildId, channelId])
}

/** Guild-scoped display alias for a Discord user (shared across games). */
model PlayerAlias {
  guildId       String
  discordUserId String
  alias         String
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@id([guildId, discordUserId])
  @@index([guildId])
}

model GameEvent {
  id        String   @id @default(cuid())
  gameId    String
  type      String
  payload   Json
  seq       Int
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, seq])
  @@index([gameId])
}
