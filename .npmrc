registry=https://registry.npmjs.org/

# Only fetch optional native binaries for this OS/CPU (skips @esbuild/win32-*, android-*, etc.).
supportedArchitectures.os=current
supportedArchitectures.cpu=current
supportedArchitectures.libc=current

# Droplets often hit timeouts or IPv6 quirks; retry and prefer IPv4 DNS.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
network-timeout=300000
network-concurrency=4

# Reuse cached package artifacts when the store already has them.
side-effects-cache=true

# Docker sets --store-dir=/pnpm/store via BuildKit cache mount.
# Locally pnpm uses its default store (~/.local/share/pnpm/store).
