DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# OAuth client secret (Discord Developer Portal → OAuth2). Required for apps/admin.
# DISCORD_CLIENT_SECRET=
# Optional locally — Docker sets file:/app/data/grimkeeper.db at runtime
# DATABASE_URL=file:./packages/database/prisma/dev.db
DEV_MODE=false
# LOG_LEVEL=debug
# Logs always go to stdout (docker compose logs). Grafana is optional — only if you enable the logging compose profile.
ADMIN_IDS=
ALLOWED_ROLE_IDS=
# Sentry — Client Keys (DSN) from https://grimkeeper.sentry.io
# Bot project (required in production for reportError → Sentry):
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_ORG=grimkeeper
# SENTRY_PROJECT=bot
# Admin Next.js project (separate DSN — do not reuse SENTRY_DSN).
# Required for server + browser capture, tracing, and Web Vitals:
# ADMIN_SENTRY_DSN=
# Optional browser override (defaults to ADMIN_SENTRY_DSN via next.config):
# NEXT_PUBLIC_ADMIN_SENTRY_DSN=
# SENTRY_PROJECT_ADMIN=admin
# Admin session replay is on-error only (replaysSessionSampleRate=0).
# Auth token for uploading admin source maps during Docker/`next build`
# (GitHub Actions secret SENTRY_AUTH_TOKEN — org token with project:releases + org:read):
# SENTRY_AUTH_TOKEN=
# Optional release override (CI Docker builds bake github.sha into the admin image):
# SENTRY_RELEASE=
# Server admin roles that can view/manage private ST player threads (comma-separated role IDs)
ADMIN_ROLE_IDS=
# Who can manage channel reminders without an active game (comma-separated role IDs)
REMINDER_ROLE_IDS=
# Players role pinged when channel reminders fire without an active game (optional if ping_role is passed in the command)
REMINDER_PING_ROLE_ID=

# Admin web UI — local: pnpm admin:dev | droplet: COMPOSE_PROFILES=admin (see apps/admin/README.md)
# ADMIN_SESSION_SECRET=
# ADMIN_OAUTH_CALLBACK_URL=http://localhost:3847/api/auth/callback/discord
# Prod example (domain): ADMIN_OAUTH_CALLBACK_URL=https://admin.example.com/api/auth/callback/discord
# Prod example (droplet IP): ADMIN_OAUTH_CALLBACK_URL=http://YOUR_DROPLET_IP:3847/api/auth/callback/discord
# Optional: AUTH_URL=http://YOUR_DROPLET_IP:3847  (defaults to origin of ADMIN_OAUTH_CALLBACK_URL)
# COMPOSE_PROFILES=admin
# ADMIN_HOST_PORT=3847
# ADMIN_BIND=0.0.0.0
# ADMIN_COOKIE_SECURE=true

# Optional: Discord thread ID for the live ST queue board panel.
# When unset, queue commands/handlers are not loaded.
# ST_QUEUE_THREAD_ID=1526334190642139346

# Optional: post errors, interaction failures, bot start/restart notices to this Discord text channel
# ERROR_CHANNEL_ID=

# GitHub Actions (build failure alerts): add the same channel id + DISCORD_TOKEN as repo secrets

# Optional: Discord webhook for CI build + deploy notifications (yaml + code blocks)
# Create in Server Settings → Integrations → Webhooks
# DISCORD_BUILD_WEBHOOK_URL=

# Droplet deploy webhook (docker compose --profile deploy up -d deploy-hook)
# Shared by Grimkeeper + Koi — one listener, one secret, two hook paths.
# Generate a long random string for DEPLOY_WEBHOOK_SECRET; add the same value as a GitHub repo secret
# in both Grimkeeper and koi-discord.
# DEPLOY_WEBHOOK_SECRET=
# DEPLOY_WEBHOOK_PORT=9000
# Grimkeeper GitHub secret DEPLOY_WEBHOOK_URL=http://YOUR_DROPLET_IP:9000/hooks/redeploy
# Koi GitHub secret        DEPLOY_WEBHOOK_URL=http://YOUR_DROPLET_IP:9000/hooks/redeploy-koi
# DEPLOY_HOOK_IMAGE=ghcr.io/YOUR_GITHUB_USER/Grimkeeper-deploy-hook:latest
# Host path of the koi-discord checkout (mounted read-only for /hooks/redeploy-koi)
# KOI_REPO_DIR=/opt/koi-discord
# Host path with docker login credentials for webhook pulls (default /root/.docker on droplet)
# DOCKER_CONFIG_DIR=/root/.docker
# Post-redeploy disk cleanup (scripts/docker-cleanup.sh — runs after each webhook redeploy)
# DOCKER_CLEANUP=1
# DOCKER_PRUNE_UNTIL=72h
# DOCKER_PRUNE_VOLUMES=0

# Legacy: poll GHCR instead of webhook (scripts/watch-image.sh)
# IMAGE_WATCH_INTERVAL=300
# AUTO_REDEPLOY=true

# Droplet: pull pre-built images from GitHub Actions (skips pnpm install on server)
# GRIMKEEPER_IMAGE=ghcr.io/YOUR_GITHUB_USER/Grimkeeper:latest
# Admin (compose profile admin) — optional; defaults to …/Grimkeeper-admin matching GRIMKEEPER_IMAGE tag
# ADMIN_IMAGE=ghcr.io/YOUR_GITHUB_USER/Grimkeeper-admin:latest
# Set automatically on redeploy: webhook, manual (docker.sh), auto (watcher), restart — not needed in .env

# Grafana Cloud Loki (optional — promtail disabled by default; see docker-compose logging profile)
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USERNAME=123456
# GRAFANA_CLOUD_LOKI_API_KEY=
