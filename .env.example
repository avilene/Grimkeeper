DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional locally — Docker sets file:/app/data/grimkeeper.db at runtime
# DATABASE_URL=file:./packages/database/prisma/dev.db
DEV_MODE=false
# full = all gameplay commands; minimal = thread + role provisioning only
BOT_MODE=full
# LOG_LEVEL=debug
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=

# Optional: post uncaught errors and interaction failures to this Discord text channel
# ERROR_CHANNEL_ID=

# Optional: Discord webhook for CI build + deploy notifications (yaml + code blocks)
# Create in Server Settings → Integrations → Webhooks
# DISCORD_BUILD_WEBHOOK_URL=

# Droplet image watcher (scripts/watch-image.sh or compose profile deploy)
# IMAGE_WATCH_INTERVAL=300
# AUTO_REDEPLOY=true

# Droplet: pull pre-built image from GitHub Actions (skips pnpm install on server)
# GRIMKEEPER_IMAGE=ghcr.io/YOUR_GITHUB_USER/Grimkeeper:latest

# Grafana Cloud Loki (optional — promtail disabled by default; see docker-compose logging profile)
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USERNAME=123456
# GRAFANA_CLOUD_LOKI_API_KEY=
