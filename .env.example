DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional locally — Docker sets file:/app/data/grimkeeper.db at runtime
# DATABASE_URL=file:./packages/database/prisma/dev.db
DEV_MODE=false
# full = all gameplay commands; minimal = channel reminders only under /st (+ game/dev minimal)
BOT_MODE=full
# LOG_LEVEL=debug
# Logs always go to stdout (docker compose logs). Grafana is optional — only if you enable the logging compose profile.
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=
# Who can manage channel reminders without an active game (comma-separated role IDs)
REMINDER_ROLE_IDS=
# Players role pinged when channel reminders fire without an active game (optional if ping_role is passed in the command)
REMINDER_PING_ROLE_ID=

# Optional: post errors, interaction failures, and bot start/restart notices to this Discord text channel
# ERROR_CHANNEL_ID=

# Optional: Discord webhook for CI build + deploy notifications (yaml + code blocks)
# Create in Server Settings → Integrations → Webhooks
# DISCORD_BUILD_WEBHOOK_URL=

# Droplet image watcher (scripts/watch-image.sh or compose profile deploy)
# IMAGE_WATCH_INTERVAL=300
# AUTO_REDEPLOY=true

# Droplet: pull pre-built image from GitHub Actions (skips pnpm install on server)
# GRIMKEEPER_IMAGE=ghcr.io/YOUR_GITHUB_USER/Grimkeeper:latest
# Set automatically on redeploy: auto (watcher), manual (docker.sh), restart — not needed in .env

# Grafana Cloud Loki (optional — promtail disabled by default; see docker-compose logging profile)
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USERNAME=123456
# GRAFANA_CLOUD_LOKI_API_KEY=
