{
  "name": "bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/index.ts 2>&1 | pino-pretty --messageKey msg --ignore pid,hostname",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@grimkeeper/database": "workspace:*",
    "@grimkeeper/engine": "workspace:*",
    "@sentry/node": "^10.67.0",
    "discord.js": "^14.26.4",
    "discordx": "^11.13.3",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
