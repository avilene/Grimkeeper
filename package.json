{
  "name": "grimkeeper",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter bot dev",
    "predev": "pnpm --filter @grimkeeper/database db:generate:if-needed",
    "test": "pnpm --filter @grimkeeper/engine test && pnpm --filter @grimkeeper/database test && pnpm --filter bot test",
    "db:push": "pnpm --filter @grimkeeper/database db:push",
    "db:generate": "pnpm --filter @grimkeeper/database db:generate",
    "db:wipe": "sh scripts/wipe-db.sh",
    "docker:redeploy": "sh scripts/docker.sh redeploy",
    "docker:cleanup": "sh scripts/docker.sh cleanup",
    "docker:restart": "sh scripts/docker.sh restart",
    "docker:logs": "sh scripts/docker.sh logs",
    "docker:fresh": "sh scripts/docker.sh fresh",
    "docker:watch": "sh scripts/watch-image.sh",
    "docker:watch:once": "WATCH_ONCE=true sh scripts/watch-image.sh"
  }
}
